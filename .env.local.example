# انسخ الملف ده باسم .env.local واملأ القيم من مشروع Supabase بتاعك
# (Project Settings -> API في داشبورد Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# مفتاح سري بيدّي صلاحية كاملة على قاعدة البيانات — بيُستخدم في لوحة الأدمن بس.
# Supabase Dashboard -> Settings -> API -> "service_role secret key"
# لا تحطه أبدًا في أي متغير اسمه بادئ بـ NEXT_PUBLIC_، ولا تشاركه مع حد.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# كلمة سر الأدمن داشبورد (اختارها انت، خليها قوية)
ADMIN_PASSWORD=change-me

